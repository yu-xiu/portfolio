---
import { SectionTitle } from "./UI";
import { Image } from "astro:assets";

const ProjectInfo = import("../utils/ProjectsList");
const { ProjectsList } = await ProjectInfo;
---

<section
    id="projects"
    class="w-full px-6 py-12 lg:py-16 bg-background"
>
    <SectionTitle title="My Projects" color="secondary">
        <div
            class="Fade_Up relative w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:px-12 pb-6"
        >
            {
                ProjectsList?.map((project) => {
                    if (project?.hideProject) return;
                    const label = project.Name.replaceAll("-", " ");
                    const tags = (project.Tech ?? []).slice(0, 4);

                    return (
                        <a
                            href={`/projects/${project?.Name.replaceAll(
                                " ",
                                "-",
                            ).toLowerCase()}`}
                            class="Project_Stagger group w-full h-full flex flex-col border border-white/10 rounded-lg overflow-hidden hover:border-white/30 transition-colors opacity-0"
                        >
                            <Image
                                class="w-full aspect-[16/10] object-cover"
                                src={project.Shot}
                                alt={`${label} screenshot`}
                                widths={[346, project.Shot.width]}
                                sizes={`(max-width: 720px) 346px, ${project.Shot.width}px`}
                                loading="lazy"
                            />
                            <div class="w-full px-5 py-5 flex flex-col flex-grow gap-3">
                                <h3 class="font-ubuntu text-[1.25em] tracking-tight">
                                    {label}
                                </h3>
                                <p class="text-sm leading-relaxed opacity-75">
                                    {project.ShortDesc}
                                </p>
                                {tags.length > 0 && (
                                    <p class="text-xs tracking-wide opacity-45">
                                        {tags.map((tech) => tech.title).join(" · ")}
                                    </p>
                                )}
                                <span class="text-sm opacity-50 mt-auto pt-2 group-hover:opacity-90 transition-opacity">
                                    View project →
                                </span>
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </SectionTitle>
</section>
