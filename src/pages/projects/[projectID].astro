---
export function getStaticPaths() {
    return [
        { params: { projectID: "xai-emotion" } },
        { params: { projectID: "poli-nlp-classifier" } },
        { params: { projectID: "davqi-educationai" } },
        { params: { projectID: "daresume" } },
    ];
}
const { projectID } = Astro.params;

import { Image } from "astro:assets";
import { ProjectLayout } from "../../layouts";
import { ExternalLinkIcon } from "lucide-preact";

const { ProjectsList } = await import("../../utils/ProjectsList");

const slugify = (s?: string) =>
    s?.toString()
        .normalize("NFKC")
        .toLowerCase()
        .trim()
        .replace(/\p{Pd}/gu, "-")
        .replace(/[_\s]+/g, "-")
        .replace(/-+/g, "-")
        .replace(/^-|-$/g, "");

const project = ProjectsList.find(
    (itm) => slugify(itm.Name) === slugify(projectID),
);

if (!project) {
    console.warn(`Project not found for slug: ${projectID}`);
    throw new Error(`Project not found for slug: ${projectID}`);
}

const humanize = (s?: string) =>
    s?.toString()
        .normalize("NFKC")
        .replace(/\p{Pd}+|_/gu, " ")
        .replace(/\s+/g, " ")
        .trim();
const displayName = humanize(project.Name);
---

<ProjectLayout
    title={`${displayName} | Tiffany Xiu`}
    description={project.ShortDesc}
>
    <article class="max-w-3xl mx-auto py-10 md:py-14">
        <a
            href="/#projects"
            class="Fade_In inline-block text-sm opacity-50 hover:opacity-90 transition-opacity mb-8"
        >
            ← Projects
        </a>

        <h1 class="Fade_Up font-ubuntu text-3xl md:text-4xl tracking-tight text-center">
            {displayName}
        </h1>
        <p class="Fade_Up text-center opacity-70 mt-4 leading-relaxed">
            {project.ShortDesc}
        </p>

        <div class="Fade_Up flex_center gap-3 mt-6 text-sm flex-wrap">
            {project.Link && (
                <a
                    href={project.Link}
                    target="_blank"
                    rel="noreferrer"
                    class="flex_center gap-2 px-4 py-2 rounded-full border border-white/25 hover:border-white/50 transition-colors"
                >
                    <ExternalLinkIcon size={16} />
                    <span>Live demo</span>
                </a>
            )}
            {project.Source && (
                <a
                    href={project.Source}
                    target="_blank"
                    rel="noreferrer"
                    class="flex_center gap-2 px-4 py-2 rounded-full border border-white/25 hover:border-white/50 transition-colors"
                >
                    <span>Source</span>
                </a>
            )}
        </div>

        {project.Tech && project.Tech.length > 0 && (
            <div class="Fade_Up flex_center flex-wrap gap-x-5 gap-y-3 mt-8">
                {project.Tech.map((tech) => (
                    <span
                        class="flex items-center gap-2 text-sm tracking-wide opacity-60"
                        title={tech.description}
                    >
                        <Image
                            class="w-[18px] h-[18px] object-contain"
                            src={tech.icon}
                            alt=""
                            width={18}
                            height={18}
                        />
                        {tech.title}
                    </span>
                ))}
            </div>
        )}

        {project.Mockup && (
            <Image
                src={project.Mockup}
                alt={`${displayName} preview`}
                width={800}
                class="Fade_Up w-full mt-12 rounded-lg"
                loading="eager"
            />
        )}

        <h2 class="Fade_Up font-ubuntu text-2xl tracking-tight text-center mt-16">
            About
        </h2>
        <div class="Fade_Up w-10 h-px bg-[var(--text)] opacity-20 mt-3 mb-6 mx-auto"></div>
        <p class="Fade_Up leading-relaxed opacity-85">
            {project.Desc}
        </p>

        {project.features && project.features.length > 0 && (
            <>
                <h2 class="Fade_Up font-ubuntu text-2xl tracking-tight text-center mt-16">
                    Features
                </h2>
                <div class="Fade_Up w-10 h-px bg-[var(--text)] opacity-20 mt-3 mb-6 mx-auto"></div>
                <dl class="space-y-5">
                    {project.features.map((feature) => (
                        <div class="Fade_Up">
                            <dt class="font-medium">{feature.title}</dt>
                            <dd class="mt-1 leading-relaxed opacity-70">
                                {feature.description}
                            </dd>
                        </div>
                    ))}
                </dl>
            </>
        )}

        {project.contributions && project.contributions.length > 0 && (
            <>
                <h2 class="Fade_Up font-ubuntu text-2xl tracking-tight text-center mt-16">
                    What I built
                </h2>
                <div class="Fade_Up w-10 h-px bg-[var(--text)] opacity-20 mt-3 mb-6 mx-auto"></div>
                <ul class="space-y-3">
                    {project.contributions.map((item) => (
                        <li class="Fade_Up flex items-start gap-3 opacity-85 leading-relaxed">
                            <span class="opacity-40 mt-1">–</span>
                            <span>{item}</span>
                        </li>
                    ))}
                </ul>
            </>
        )}
    </article>
</ProjectLayout>
