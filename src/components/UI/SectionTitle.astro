---
type Props = {
    title: string;
    className?: string;
    color?: "primary" | "secondary";
};
const { title, className }: Props = Astro.props;
---

<div class={`Fade_Up my-4 ${className ?? ""}`}>
    <h2 class="Fade_Up text-xl lg:text-2xl font-ubuntu tracking-tight text-center">
        {title}
    </h2>
    <div class="Fade_Up w-10 h-px bg-[var(--text)] opacity-20 mt-3 mb-6 mx-auto"></div>
    <slot />
</div>
