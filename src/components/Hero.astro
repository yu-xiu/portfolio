---
import { Image } from "astro:assets";
import Avatar_westie from "../Avatar_westie.webp"
---

<section
    id="Hero"
    class="w-full min-h-[calc(100vh-4rem)] px-6 py-12 lg:py-4 bg-background flex justify-evenly lg:justify-around items-center flex-col-reverse lg:flex-row"
>
    <!-- Hero Intro Info -->
    <div class="w-full lg:w-fit flex justify-start items-center flex-col gap-6">
        <div class="text-[14px] sm:text-[16px] lg:text-[21px] text-center lg:text-left px-1">
            

            <p class="Fade_Stagger">Hi, I'm</p>
            <h1
                class="Fade_Stagger text-white font-ubuntu text-[3.2em] sm:text-[3.6em] lg:text-[6.5rem] leading-tight"
            >
                Tiffany.
            </h1>
            <p class="Fade_Stagger">
                I design and build AI-powered products.
            </p>
            <p class="Fade_Stagger mt-3 text-xs lg:text-sm leading-relaxed text-white/60">
                Agentic AI · NLP · RAG · RL · Explainable ML
            </p>
            <p class="Fade_Stagger mt-2 text-[0.7rem] lg:text-xs tracking-wide text-white/45">
                Bay Area, CA · ex-NASA Ames · Darluwin AI Labs
            </p>
        </div>

        <!-- CTA Buttons -->
        <div class="Fade_Stagger flex flex-wrap justify-center lg:justify-start gap-3 mt-1 w-full">
            <a 
                href="#projects" 
                class="px-5 py-2.5 text-sm bg-primary text-white rounded-full font-medium hover:opacity-90 transition-opacity duration-200"
            >
                View My Work
            </a>
            <a 
                href="/yu_xiu_resume.pdf" 
                target="_blank"
                class="px-5 py-2.5 text-sm border border-white/25 text-white rounded-full font-medium hover:border-white/50 transition-colors duration-200"
            >
                Resume
            </a>
        </div>

        <div
            class="Fade_Stagger flex justify-center lg:justify-start items-center w-full gap-8 py-2"
        >
            <a
                href="https://github.com/yu-xiu"
                title="GitHub"
                target="_blank"
                rel="author"
                aria-label="GitHub"
                class="Fade_Stagger"
            >
                <svg
                    stroke="currentColor"
                    fill="currentColor"
                    stroke-width="0"
                    viewBox="0 0 16 16"
                    color="#fff"
                    height="25"
                    width="25"
                    xmlns="http://www.w3.org/2000/svg"
                    style="color: var(--heroSocialColor);"
                >
                    <path
                        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                    >
                    </path>
                </svg>
            </a>
            <a
                href="https://www.linkedin.com/in/yu-xiu/"
                title="LinkedIn"
                target="_blank"
                rel="noreferrer"
                aria-label="LinkedIn"
                class="Fade_Stagger"
            >
                <svg
                    stroke="currentColor"
                    fill="currentColor"
                    stroke-width="0"
                    viewBox="0 0 16 16"
                    color="var(--text)"
                    height="25"
                    width="25"
                    xmlns="http://www.w3.org/2000/svg"
                    style="color: var(--heroSocialColor);"
                >
                    <path
                        d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
                    >
                    </path>
                </svg>
            </a>
        </div>
    </div>

    <div class="Spring_Up flex_center w-[160px] lg:w-[225px]">
        <Image
            src={Avatar_westie}
            alt="Tiffany with her Westie"
            class="w-full h-auto"
            width="225"
            height="225"
            loading="eager"
        />
    </div>
</section>
