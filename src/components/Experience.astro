---
import { SectionTitle } from "./UI";

const timeline = [
    {
        date: "2025 — Present",
        title: "Founder & Full-Stack AI Engineer",
        company: "Darluwin AI Labs",
        location: "Bay Area, CA",
        bullets: [
            "Built and shipped full-stack AI applications, including DaResume, an AI-powered resume and job matching and interview preparation platform, and DaVQi Education, an AI learning platform for personalized tutoring, assessment, and content generation.",
        ],
        tags: ["Agent", "NLP", "RL", "Full-stack"],
    },
    {
        date: "2023 — 2024",
        title: "System and Software Engineer",
        company: "NASA Ames",
        location: "Mountain View, CA",
        bullets: [
            "Supported the ISRDS program under NASA’s Intelligent Systems Division, contributing to simulation modeling, testing, and data analysis for spacecraft fault detection.",
        ],
        tags: ["Simulink", "MATLAB", "Stateflow"],
    },
    {
        date: "2023",
        title: "Math Tutor",
        company: "Math Culture LLC",
        location: "Los Altos, CA",
        bullets: [
            "Taught Math Kangaroo competition prep classes for elementary school students at Santa Rita Elementary School.",
        ],
        tags: ["Algebra"],
    },
    {
        date: "2017 — 2018",
        title: "Math Tutor",
        company: "Foothill College",
        location: "Los Altos, CA",
        bullets: [
            "Provided one-on-one Calculus tutoring to college students.",
        ],
        tags: ["Algebra", "Trigonometry", "Calculus"],
    },
];
---

<section id="experience" class="w-full px-6 py-12 lg:py-16 bg-background">
    <SectionTitle title="Work Experience" color="secondary">
        <div class="max-w-2xl mx-auto flex flex-col gap-10 py-6">
            {
                timeline.map((item) => (
                    <article class="Fade_Up">
                        <time class="text-xs opacity-50">{item.date}</time>
                        <h3 class="text-base font-ubuntu tracking-tight mt-1">
                            {item.title}
                        </h3>
                        <p class="text-[0.8rem] opacity-80 mt-0.5">
                            {item.company}
                            <span class="opacity-40"> · </span>
                            {item.location}
                        </p>
                        <ul class="mt-2.5 space-y-1.5 text-[0.8rem] opacity-75 leading-relaxed">
                            {item.bullets.map((b) => (
                                <li>{b}</li>
                            ))}
                        </ul>
                        {item.tags?.length > 0 && (
                            <p class="mt-2.5 text-[0.7rem] tracking-wide opacity-40">
                                {item.tags.join(" · ")}
                            </p>
                        )}
                    </article>
                ))
            }
        </div>
    </SectionTitle>
</section>
