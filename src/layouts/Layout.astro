---
import { SEO } from "astro-seo";
import { AstroFont } from "astro-font";
import { join } from "node:path";
import { Header, MobileHeader } from "../components/UI";
import { Footer } from "../components";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#000" />
		<meta name="robots" content="index, follow" />
		
		<meta
			name="keywords"
			content="Tiffany Xiu, Portfolio, Reinforcement Learning, NLP, Explainable AI, NASA Ames, Network Routing, Audio Emotion Analysis"
		/>

		<meta name="author" content="Yu Xiu" />
		<meta name="publisher" content="Yu Xiu" />
		<link rel="manifest" href="/manifest.json" />

		<!-- Preload CSS Styles -->
		<link rel="preload stylesheet" href="/styles/global.css" as="style" />
		<link rel="preload stylesheet" href="/styles/utility.css" as="style" />

		<SEO
			title="Tiffany Xiu | AI Researcher & Developer Portfolio"
  			description="Personal portfolio showcasing my projects in Reinforcement Learning, NLP, and AI applications."
  			canonical="https://tiffanyxiu.vercel.app/"
			extend={{
				link: [
					{ rel: "icon", type: "image/png", href: "/web-app-icon.png" },
					{
						rel: "shortcut",
						type: "image/png",
						href: "/web-icon.png",
					},
					
				],
			}}
		/>

		<AstroFont
			config={[
				{
					name: "Poppins",
					src: [
						{
							weight: "400",
							style: "normal",
							path: join(
								process.cwd(),
								"public",
								"fonts",
								"poppins-v20-latin-regular.woff2",
							),
						},
					],
					preload: true,
					display: "swap",
					fallback: "serif",
					cssVariable: "astro-font-poppins",
				},
				{
					name: "Ubuntu",
					src: [
						{
							weight: "700",
							style: "normal",
							path: join(
								process.cwd(),
								"public",
								"fonts",
								"ubuntu-v20-latin-700.woff2",
							),
						},
					],
					preload: true,
					display: "swap",
					fallback: "serif",
					cssVariable: "astro-font-ubuntu",
				},
			]}
		/>

		<style is:global>
			:root {
				--base: #000000;
				--baseLite: rgba(0, 0, 0, 0.85);
				--text: #fff;

				--pH: 264;
				--pS: 100%;
				--pL: 50%;

				--sH: 315;
				--sS: 100%;
				--sL: 50%;

				--mH: 275;
				--mS: 100%;
				--mL: 47%;

				/* --primary: 264, 100%, 50%;
				--secondary: 315, 100%, 50%;
				--mixColor: 275, 100%, 47%; */

				--primary: var(--pH), var(--pS), var(--pL);
				--secondary: var(--sH), var(--sS), var(--sL);
				--mixColor: var(--mH), var(--mS), var(--mL);

				--primaryLite: hsla(var(--primary), 0.6);
				--primaryLiteAlt: hsla(var(--primary), 0.3);
				--secondaryLite: hsla(var(--secondary), 0.6);
				--secondaryLiteAlt: hsla(var(--secondary), 0.3);

				--footer: hsl(264, 100%, 15%);
				--footerSvgA: hsl(259, 75%, 10%);
				--footerSvgB: hsl(256, 60%, 5%);

				--gradient: linear-gradient(
					to right,
					hsl(var(--secondary)),
					hsl(var(--primary)),
					hsl(var(--primary)),
					hsl(var(--secondary))
				);
				--gradientLite: linear-gradient(
					45deg,
					var(--primaryLite),
					hsl(var(--secondaryLite))
				);

				--headerGradient: linear-gradient(
					180deg,
					rgba(0, 0, 0, 0.6),
					transparent
				);
				--cardGradient: linear-gradient(
					45deg,
					hsl(0, 0%, 1%),
					var(--primaryLite)
				);
				--cardGradientAlt: linear-gradient(
					-135deg,
					hsl(0, 0%, 5%),
					var(--primaryLiteAlt)
				);
				--miscCardGradient: linear-gradient(
					-45deg,
					hsl(0, 0%, 1%),
					var(--primaryLiteAlt)
				);
				--overlayGradient: radial-gradient(
					farthest-corner at 100% 0%,
					hsla(0, 0%, 5%, 0.5),
					transparent
				);
				--LinkBtnGradient: linear-gradient(
					-135deg,
					hsla(0, 0%, 9%, 0.8),
					hsla(0, 0%, 10%, 0.6)
				);
				--SkillGradient: linear-gradient(
					-135deg,
					hsla(276, 50%, 10%, 0.8),
					hsla(296, 50%, 10%, 0.5)
				);
				--SkillGradientAlt: linear-gradient(
					-135deg,
					hsla(276, 50%, 10%, 0.4),
					hsla(296, 50%, 10%, 0.25)
				);
				--orbitGradient: conic-gradient(
					transparent,
					transparent,
					hsl(var(--primary)),
					hsl(var(--secondary)),
					#fff
				);
				--orbitGradientAlt: conic-gradient(
					#fff,
					hsl(var(--primary)),
					hsl(var(--secondary)),
					transparent,
					transparent
				);

				--orbitDotColor: #fff;
				--heroSocialColoe: #fff;
				--contactSocialColor: hsla(0, 0%, 100%, 0.4);

				--cursorColor: hsla(0, 0%, 100%, 0.6);
				--cursorColorAlt: hsla(0, 0%, 100%, 0.8);
				--dotColor: #fff;
			}

			html.light {
				--base: #fff;
				--baseLite: rgba(255, 255, 255, 0.85);
				--text: #000;

				--pH: 264;
				--pS: 100%;
				--pL: 50%;

				--sH: 315;
				--sS: 100%;
				--sL: 50%;

				--mH: 275;
				--mS: 100%;
				--mL: 47%;

				/* --pH: 240;
				--pS: 60%;
				--pL: 35%;

				--sH: 190;
				--sS: 80%;
				--sL: 50%;

				--mH: 200;
				--mS: 80%;
				--mL: 60%; */

				/* --primary: 264, 100%, 50%;
				--secondary: 315, 100%, 50%;
				--mixColor: 275, 100%, 47%; */

				--primary: var(--pH), var(--pS), var(--pL);
				--secondary: var(--sH), var(--sS), var(--sL);
				--mixColor: var(--mH), var(--mS), var(--mL);

				--primaryLite: hsla(var(--primary), 0.6);
				--primaryLiteAlt: hsla(var(--primary), 0.3);
				--secondaryLite: hsla(var(--secondary), 0.6);
				--secondaryLiteAlt: hsla(var(--secondary), 0.3);

				--footer: hsl(var(--pH), var(--pS), 75%);
				--footerSvgA: hsl(var(--pH), var(--pS), 85%);
				--footerSvgB: hsl(var(--pH), var(--pS), 90%);

				--gradient: linear-gradient(
					to right,
					hsl(var(--secondary)),
					hsl(var(--primary)),
					hsl(var(--primary)),
					hsl(var(--secondary))
				);
				--gradientLite: linear-gradient(
					45deg,
					var(--primaryLite),
					hsl(var(--secondaryLite))
				);

				--headerGradient: linear-gradient(
					180deg,
					rgba(255, 255, 255, 0.6),
					transparent
				);
				--cardGradient: linear-gradient(
					45deg,
					hsl(var(--secondary), 0.1),
					var(--primaryLiteAlt)
				);
				--cardGradientAlt: linear-gradient(
					-135deg,
					var(--primaryLiteAlt),
					hsl(0, 0%, 100%)
				);
				--miscCardGradient: linear-gradient(
					-45deg,
					var(--primaryLiteAlt),
					hsl(0, 0%, 100%)
				);
				--overlayGradient: radial-gradient(
					farthest-corner at 100% 0%,
					hsla(0, 0%, 100%, 0.5),
					transparent
				);
				--LinkBtnGradient: linear-gradient(
					-135deg,
					hsla(var(--secondary), 0.15),
					hsla(var(--mixColor), 0.15)
				);
				--SkillGradient: linear-gradient(
					-135deg,
					hsla(var(--mixColor), 0.125),
					hsla(var(--primary), 0.25)
				);
				--SkillGradientAlt: linear-gradient(
					-135deg,
					hsla(var(--primary), 0.15),
					hsla(var(--secondary), 0.15)
				);
				--orbitGradient: conic-gradient(
					transparent,
					transparent,
					hsl(var(--secondary)),
					hsl(var(--primary))
				);
				--orbitGradientAlt: conic-gradient(
					hsl(var(--primary)),
					hsl(var(--secondary)),
					transparent,
					transparent
				);

				--orbitDotColor: hsl(var(--mixColor));
				--heroSocialColor: hsl(0, 0%, 20%);
				--contactSocialColor: hsla(0, 0%, 20%, 0.4);

				--cursorColor: hsla(var(--primary), 0.6);
				--cursorColorAlt: hsla(var(--primary), 0.6);
				--dotColor: hsl(var(--mixColor));
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				font-family: Poppins !important;
			}

			body {
				background-color: var(--base);
				color: var(--text);
			}

			/* Header */
			.Header_Nav a {
				position: relative;
				overflow: hidden;
				letter-spacing: 1px;
			}

			.Header_Nav a::after {
				content: "";
				position: absolute;
				bottom: 0;
				left: 0;
				width: 100%;
				height: 2px;
				background-color: var(--orbitDotColor);
				transform: scaleX(0);
				transition: transform 0.25s ease-out;
			}

			.Header_Nav a.active::after {
				transform: scaleX(1);
			}

			/* Action Button Style */
			.Header_ActionBtn {
				position: relative;
				border-radius: 9999px;
				overflow: hidden;
				display: grid;
				place-items: center;
				border: 1px solid hsla(0, 0%, 100%, 0.25);
				transition: border-color 0.2s ease, background-color 0.2s ease;
			}

			.Header_ActionBtn > div {
				padding: 0.35em 1.15em;
				color: var(--text);
				border-radius: inherit;
				z-index: 2;
			}

			.Header_ActionBtn:hover {
				border-color: hsla(0, 0%, 100%, 0.5);
				background-color: hsla(0, 0%, 100%, 0.06);
			}

			/* Mobile Header Nav */
			.MobileHeader_Nav {
				min-width: 14em;
				text-align: center;
				background-color: var(--base);
				border-radius: 0.3em;
				padding: 1em;
				font-size: 1.3em;
				font-weight: 700;
				letter-spacing: 1px;
			}

			.MobileHeader_Nav a {
				width: 100%;
				color: var(--text);
				text-decoration: none;
				text-transform: uppercase;
			}

			.MobileHeader_Nav a.active {
				background: var(--gradient);
				background-clip: text;
				-webkit-background-clip: text;
				color: transparent;
			}

			:has(.MobileHeader_ActionBtn).MobileHeader_Nav {
				padding: 0;
			}

			.MobileHeader_ActionBtn {
				position: relative;
				border-radius: 0.3em;
				overflow: hidden;
				border: 1px solid hsla(0, 0%, 100%, 0.25);
			}

			.MobileHeader_ActionBtn > div {
				padding: 0.7em 1em;
				width: 100%;
				color: var(--text);
				border-radius: inherit;
				z-index: 2;
			}

			/* Mobile Ham Menu Animation --> */
			.MobileNav_Ham {
				-webkit-tap-highlight-color: transparent;
				transition: transform 0.4s;
				user-select: none;
			}

			.MobileNav_Ham .line {
				fill: none;
				transition:
					stroke-dasharray 0.4s,
					stroke-dashoffset 0.4s;
				stroke: var(--text);
				stroke-width: 5.5;
				transform-origin: right;
				stroke-linecap: round;
			}

			html.light .MobileNav_Ham .line {
				stroke: hsl(var(--primary)) !important;
			}

			.MobileNav_Ham .top {
				stroke-dasharray: 18 160;
			}

			.MobileNav_Ham .middle {
				stroke-dasharray: 40 142;
				transform-origin: 83% 83%;
				transition: transform 0.4s;
			}

			.MobileNav_Ham .bottom {
				stroke-dasharray: 18 85;
				transform-origin: 50%;
				transition:
					transform 0.4s,
					stroke-dashoffset 0.4s;
			}

			.Projects_Link {
				padding: 0.45em;
				border: 1px solid var(--primaryLite);
				border-radius: 100%;
				z-index: 10;
			}

			footer {
				color: #fff !important;
			}

			/* Lenis Smooth Scroll */
			html.lenis {
				height: auto;
			}

			.lenis.lenis-smooth {
				scroll-behavior: auto !important;
			}

			.lenis.lenis-smooth [data-lenis-prevent] {
				overscroll-behavior: contain;
			}

			.lenis.lenis-stopped {
				overflow: hidden;
			}

			.lenis.lenis-scrolling iframe {
				pointer-events: none;
			}

			/* GSAP Animation inits */
			.flex_center {
				display: flex;
				justify-content: center;
				align-items: center;
			}

			.gradientText {
				background: var(--gradient);
				background-clip: text;
				-webkit-background-clip: text;
				color: transparent;
			}

			.Fade_Stagger,
			.Fade_Up {
				opacity: 0;
				transform: translateY(50);
			}

			.Fade_Down {
				opacity: 0;
				transform: translateY(-50);
			}

			.Fade_In {
				opacity: 0;
			}

			.Spring_Up {
				opacity: 0;
				scale: 0.96;
			}
		</style>
	</head>
	<body id="home">
		<!-- Scroll Progress Bar -->
		<div id="scroll-progress" class="scroll-progress" style="width: 0%;"></div>
		
		<Header />
		<MobileHeader />

		<main>
			<slot />
		</main>

		<Footer />
		<script src="../script.ts"></script>
	</body>
</html>
