---
import { SectionTitle } from "./UI";

const timeline = [
    {
        date: "2025 — Present",
        title: "AI Software Engineer",
        company: "Stealth Startup",
        location: "Bay Area, CA",
        bullets: [
            "Built NLP + RL prototypes; shipped full-stack demos",
        ],
        tags: ["NLP", "RL", "Full-stack"],
    },
    {
        date: "2023 — 2024",
        title: "System and Software Engineer",
        company: "NASA Ames",
        location: "Mountain View, CA",
        bullets: [
            "Simulink, Stateflow, and MATLAB spacecraft models & testing",
        ],
        tags: ["Simulink", "MATLAB", "Stateflow"],
    },
    {
        date: "2023",
        title: "Math Tutor",
        company: "Math Culture LLC",
        location: "Los Altos, CA",
        bullets: [
            "Taught Math Kangaroo competition classes at Santa Rita Elementary.",
        ],
        tags: ["Algebra"],
    },
    {
        date: "2017 — 2018",
        title: "Math Tutor",
        company: "Foothill College",
        location: "Los Altos, CA",
        bullets: [
            "Tutored college students in Calculus.",
        ],
        tags: ["Algebra", "Trigonometry", "Calculus"],
    },
];
---

<section id="experience" class="w-full px-6 py-12 lg:py-16 bg-background">
    <SectionTitle title="Work Experience" color="secondary">
        <div class="max-w-2xl mx-auto flex flex-col gap-10 py-6">
            {
                timeline.map((item) => (
                    <article class="Fade_Up">
                        <time class="text-sm opacity-50">{item.date}</time>
                        <h3 class="text-lg font-ubuntu tracking-tight mt-1">
                            {item.title}
                        </h3>
                        <p class="text-sm opacity-80 mt-0.5">
                            {item.company}
                            <span class="opacity-40"> · </span>
                            {item.location}
                        </p>
                        <ul class="mt-3 space-y-1.5 text-sm opacity-75 leading-relaxed">
                            {item.bullets.map((b) => (
                                <li>{b}</li>
                            ))}
                        </ul>
                        {item.tags?.length > 0 && (
                            <p class="mt-3 text-xs tracking-wide opacity-40">
                                {item.tags.join(" · ")}
                            </p>
                        )}
                    </article>
                ))
            }
        </div>
    </SectionTitle>
</section>
