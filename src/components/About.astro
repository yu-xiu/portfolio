---
import { Image } from "astro:assets";
import about_avatar from "../about_avatar.webp";
import { SectionTitle } from "./UI";
---

<section id="about" class="w-full px-6 py-12 lg:py-16 bg-background">
    <SectionTitle
        title="About Me"
        color="primary"
        className="flex flex-col justify-center"
    >
        <div class="flex_center flex-col lg:flex-row w-full max-w-5xl mx-auto h-full py-6 gap-10 lg:gap-14">
            <div class="Fade_Up relative flex-shrink-0">
                <Image
                    src={about_avatar}
                    alt="About_Avatar"
                    class="relative rounded-full ring-1 ring-white/15"
                    width={280}
                    height={280}
                    srcset={`${about_avatar.src} 250w, ${about_avatar.src} 300w`}
                    sizes="(min-width: 1024px) 280px, 250px"
                    loading="lazy"
                />
            </div>

            <div
                class="Fade_Up w-full lg:max-w-xl flex justify-center items-start flex-col gap-5 lg:border-l border-white/15 py-8 lg:pl-12"
            >
                <h2 class="Fade_Up text-2xl lg:text-3xl font-bold">
                    Welcome to my page.
                </h2>
                <p class="Fade_Up text-base lg:text-lg leading-relaxed text-justify opacity-90">
                    I'm Tiffany, an AI builder and startup founder. 
                    I like taking ambitious ideas and turning them into products people can actually use.
                    I work across <span class="text-primary font-medium">NLP</span>, <span class="text-primary font-medium">RAG</span>, and <span class="text-primary font-medium">Generative AI</span>, and I'm especially interested in making AI systems more reliable and explainable.
                </p>
                <p class="Fade_Up text-base lg:text-lg leading-relaxed text-justify opacity-90">
                    Before that, I interned at <span class="text-secondary font-medium">NASA Ames</span>, contributing to spacecraft system modeling and testing. 
                    The experience shaped how I think about engineering: build for real constraints, test carefully, and prioritize systems that hold up in the real world. 
                </p>
                <p class="Fade_Up text-base lg:text-lg leading-relaxed text-justify opacity-90">
                    Now I'm building an early-stage AI startup, exploring agent workflows and retrieval-driven experiences that bridge research and real-world impact.
                </p>
            </div>
        </div>

    </SectionTitle>
</section>
