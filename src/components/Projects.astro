---
import { SectionTitle } from "./UI";
import { Image } from "astro:assets";

const ProjectInfo = import("../utils/ProjectsList");
const { ProjectsList } = await ProjectInfo;
---

<section
    id="projects"
    class="w-full px-6 py-12 lg:py-16 bg-background"
>
    <SectionTitle title="My Projects" color="secondary">
        <div
            class="Fade_Up relative w-full max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 pb-6"
        >
            {
                ProjectsList?.map((project) => {
                    if (project?.hideProject) return;
                    const label = project.Name.replaceAll("-", " ");
                    const tags = (project.Tech ?? []).slice(0, 4);

                    return (
                        <a
                            href={`/projects/${project?.Name.replaceAll(
                                " ",
                                "-",
                            ).toLowerCase()}`}
                            class="Project_Stagger group w-full h-full flex flex-col border border-white/30 rounded-lg overflow-hidden hover:border-white/60 transition-colors opacity-0"
                        >
                            <div class="w-full aspect-[16/10] bg-white/5 overflow-hidden flex items-center justify-center p-4">
                                <Image
                                    class="max-w-full max-h-full w-auto h-auto object-contain rounded"
                                    src={project.Shot}
                                    alt={`${label} screenshot`}
                                    widths={[346, project.Shot.width]}
                                    sizes={`(max-width: 720px) 346px, ${project.Shot.width}px`}
                                    loading="lazy"
                                />
                            </div>
                            <div class="w-full px-4 py-4 flex flex-col flex-grow gap-2.5">
                                <h3 class="font-ubuntu text-[1.05em] tracking-tight">
                                    {label}
                                </h3>
                                <p class="text-[0.8rem] leading-relaxed opacity-75">
                                    {project.ShortDesc}
                                </p>
                                {tags.length > 0 && (
                                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                                        {tags.map((tech) => (
                                            <span class="flex items-center gap-1.5 text-[0.7rem] tracking-wide opacity-60">
                                                <Image
                                                    class="w-[14px] h-[14px] object-contain"
                                                    src={tech.icon}
                                                    alt=""
                                                    width={14}
                                                    height={14}
                                                    loading="lazy"
                                                />
                                                {tech.title}
                                            </span>
                                        ))}
                                    </div>
                                )}
                                <span class="text-[0.8rem] opacity-50 mt-auto pt-2 group-hover:opacity-90 transition-opacity">
                                    View project →
                                </span>
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </SectionTitle>
</section>
