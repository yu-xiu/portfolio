---
type Props = {
    title: string;
    color?: "primary" | "secondary";
};
const { title }: Props = Astro.props;
---

<div class="Fade_Up flex flex-col items-center my-6">
    <h2 class="text-xl lg:text-2xl font-ubuntu tracking-tight">{title}</h2>
    <div class="w-10 h-px bg-[var(--text)] opacity-20 mt-3"></div>
</div>
